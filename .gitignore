# Gradle / Flutter / IDE build output
.gradle/
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
local.properties
.idea/
*.iml

# Large media and archives are not part of this repo
*.webm
*.mp4
*.zip
*.rar
*.7z

# Secrets
.env
.env.*

# LaTeX sources stay local; only the compiled PDFs are pushed
*.tex

# Screenshots used by the .tex sources stay local
lectures/img/

# Code examples stay local (not pushed to GitHub)
/code/
